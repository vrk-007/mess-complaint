generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  rollNo        String?
  hostel        String?
  mess          String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  complaints     Complaint[]
  canteenRatings CanteenRating[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Complaint {
  id           String   @id @default(cuid())
  userId       String
  mess         String?  // venue: user's mess name or "VNIT Canteen" (nullable for legacy rows)
  meal         String
  category     String
  incidentDate String?
  description  String
  imageUrl     String?  // Supabase Storage public URL for optional photo evidence
  tokenId      String?  // which QR token was used (audit trail)
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  // ── Escalation to SuperAdmin ──────────────────────────────────
  isForwarded  Boolean   @default(false)
  forwardedAt  DateTime?
  forwardedBy  String?   // email of the Admin who escalated
  forwardNote  String?   // reason for escalation (max 300 chars)

  // ── Admin / SuperAdmin Remarks ────────────────────────────────
  adminRemark  String?   // latest remark text
  remarkBy     String?   // email of who wrote the remark
  remarkAt     DateTime?

  // ── Resolution Approval Workflow ──────────────────────────────
  pendingApproval   Boolean   @default(false)  // Admin submitted resolve, waiting for Escalator
  resolutionRemark  String?   // remark Admin typed when requesting resolve
  resolvedBy        String?   // email of Admin who submitted the resolution request
  approvedBy        String?   // email of Escalator who approved it
  approvedAt        DateTime?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  token ComplaintToken? @relation(fields: [tokenId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([resolved, createdAt(sort: Desc)])
  @@index([isForwarded, createdAt(sort: Desc)])
}

model ComplaintToken {
  id         String    @id @default(cuid())
  token      String    @unique  // secure random string embedded in QR
  status     TokenStatus @default(ACTIVE)
  createdBy  String               // userId of admin who generated it
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  complaint  Complaint[]
}

enum TokenStatus {
  ACTIVE
  USED
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

model CanteenRating {
  id                String   @id @default(cuid())
  userId            String
  item              String
  rating            Int
  comment           String?
  quantityRating    Int?     // optional 1-5 stars for quantity of food item
  hygieneRating     Int?     // optional 1-5 stars for hygiene of food item
  staffRating       Int?     // optional 1-5 stars for behaviour of staff
  cleanlinessRating Int?     // optional 1-5 stars for cleanliness of canteen
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([item, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}
